---
/**
 * BlobShape — forme organique signature de la flotte.
 *
 * Conteneur arrondi par coins inégaux. Par défaut il prend la forme `--bot-blob`
 * du bot actif (héritée du contexte [data-bot] ancêtre) ; sinon le `--r-blob`
 * générique. Sert d'écrin à un emoji/glyphe (slot) — mascotte, icône de bot, etc.
 *
 * @prop {('blob'|'pill'|'round'|'soft')} [shape='blob'] - Forme du conteneur.
 *   - blob  : `--bot-blob` du bot actif (forme organique signature).
 *   - round : cercle parfait.
 *   - pill  : rayon `--r-pill`.
 *   - soft  : rayon `--r-md` (coins doux réguliers).
 * @prop {string} [size='60px'] - Taille (largeur = hauteur), valeur CSS.
 * @prop {('tint'|'solid'|'plain')} [fill='solid'] - Remplissage.
 *   - solid : dégradé accent-300 → accent-500 (mascotte vive).
 *   - tint  : wash accent-100 + liseré accent-200 (icône discrète).
 *   - plain : surface --c-paper-0 + liseré --c-line (neutre).
 * @prop {boolean} [float=false] - Active la respiration flottante (translateY).
 *   Désactivée sous prefers-reduced-motion.
 * @prop {string} [class] - Classes additionnelles.
 * @slot default - Contenu centré (emoji, glyphe, SVG…). aria-hidden par défaut.
 */
interface Props {
  shape?: "blob" | "pill" | "round" | "soft";
  size?: string;
  fill?: "tint" | "solid" | "plain";
  float?: boolean;
  class?: string;
}

const {
  shape = "blob",
  size = "60px",
  fill = "solid",
  float = false,
  class: className = "",
} = Astro.props;
---

<span
  class:list={["bdf-blob", `bdf-blob--${shape}`, `bdf-blob--${fill}`, { "bdf-blob--float": float }, className]}
  style={`--blob-size:${size}`}
  aria-hidden="true"
>
  <slot />
</span>

<style>
  .bdf-blob {
    display: grid;
    place-items: center;
    width: var(--blob-size);
    height: var(--blob-size);
    flex: none;
    font-size: calc(var(--blob-size) * 0.42);
    line-height: 1;
    box-shadow: var(--shadow-md), inset 0 2px 4px rgba(255, 255, 255, 0.4);
    transition: border-radius var(--dur-slow) var(--ease-spring),
      transform var(--dur-base) var(--ease-spring);
  }

  .bdf-blob--blob { border-radius: var(--bot-blob); }
  .bdf-blob--round { border-radius: 50%; }
  .bdf-blob--pill { border-radius: var(--r-pill); }
  .bdf-blob--soft { border-radius: var(--r-md); }

  .bdf-blob--solid {
    background: linear-gradient(145deg, var(--accent-300), var(--accent-500));
  }
  .bdf-blob--tint {
    background: color-mix(in srgb, var(--accent-100) 70%, var(--c-paper-0));
    border: 1px solid var(--accent-200);
    box-shadow: var(--shadow-sm);
  }
  .bdf-blob--plain {
    background: var(--c-paper-0);
    border: 1px solid var(--c-line);
    box-shadow: var(--shadow-sm);
  }

  .bdf-blob--float {
    animation: bdf-blob-float var(--dur-float) var(--ease-inout) infinite;
    will-change: transform;
  }
  @keyframes bdf-blob-float {
    0%, 100% { transform: translate3d(0, 0, 0) rotate(0deg); }
    50% { transform: translate3d(0, -10px, 0) rotate(-2deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .bdf-blob { animation: none; }
  }
</style>
