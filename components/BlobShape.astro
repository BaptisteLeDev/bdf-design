---
/**
 * BlobShape — écrin géométrique discret pour un glyphe (ex-forme organique).
 *
 * Direction « neo-grotesque minimal » : plus de blobs organiques. Conteneur à
 * rayon net (`--bot-blob` désormais aliasé sur un rayon serré commun). Sert
 * d'écrin sobre à un emoji/glyphe (slot) — mascotte, icône de bot, etc.
 * Composant et props CONSERVÉS (le portail l'importe) ; le rendu est juste sobre.
 *
 * @prop {('blob'|'pill'|'round'|'soft')} [shape='blob'] - Forme du conteneur.
 *   - blob  : rayon `--bot-blob` (net, plus organique).
 *   - round : cercle parfait.
 *   - pill  : rayon `--r-pill`.
 *   - soft  : rayon `--r-md` (coins doux réguliers).
 * @prop {string} [size='60px'] - Taille (largeur = hauteur), valeur CSS.
 * @prop {('tint'|'solid'|'plain')} [fill='solid'] - Remplissage.
 *   - solid : aplat accent-500 (glyphe en évidence, sobre).
 *   - tint  : wash accent-100 + liseré accent-200 (icône discrète).
 *   - plain : surface --c-paper-0 + liseré --c-line (neutre).
 * @prop {boolean} [float=false] - Active une respiration flottante très discrète.
 *   Désactivée sous prefers-reduced-motion.
 * @prop {string} [class] - Classes additionnelles.
 * @slot default - Contenu centré (emoji, glyphe, SVG…). aria-hidden par défaut.
 */
interface Props {
  shape?: "blob" | "pill" | "round" | "soft";
  size?: string;
  fill?: "tint" | "solid" | "plain";
  float?: boolean;
  class?: string;
}

const {
  shape = "blob",
  size = "60px",
  fill = "solid",
  float = false,
  class: className = "",
} = Astro.props;
---

<span
  class:list={["bdf-blob", `bdf-blob--${shape}`, `bdf-blob--${fill}`, { "bdf-blob--float": float }, className]}
  style={`--blob-size:${size}`}
  aria-hidden="true"
>
  <slot />
</span>

<style>
  .bdf-blob {
    display: grid;
    place-items: center;
    width: var(--blob-size);
    height: var(--blob-size);
    flex: none;
    font-size: calc(var(--blob-size) * 0.42);
    line-height: 1;
    box-shadow: var(--shadow-xs);
    transition: border-radius var(--dur-base) var(--ease-soft),
      transform var(--dur-base) var(--ease-soft);
  }

  .bdf-blob--blob { border-radius: var(--bot-blob); }
  .bdf-blob--round { border-radius: 50%; }
  .bdf-blob--pill { border-radius: var(--r-pill); }
  .bdf-blob--soft { border-radius: var(--r-md); }

  .bdf-blob--solid {
    background: var(--accent-500);
    color: #fff;
  }
  .bdf-blob--tint {
    background: color-mix(in srgb, var(--accent-100) 70%, var(--c-paper-0));
    border: 1px solid var(--accent-200);
    box-shadow: none;
  }
  .bdf-blob--plain {
    background: var(--c-paper-0);
    border: 1px solid var(--c-line);
    box-shadow: none;
  }

  .bdf-blob--float {
    animation: bdf-blob-float var(--dur-float) var(--ease-inout) infinite;
    will-change: transform;
  }
  @keyframes bdf-blob-float {
    0%, 100% { transform: translate3d(0, 0, 0); }
    50% { transform: translate3d(0, -5px, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .bdf-blob { animation: none; }
  }
</style>
