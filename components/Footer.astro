---
/**
 * Footer - pied de page de la flotte (tagline + colonnes de liens + barre légale).
 *
 * @prop {string} brand - Nom de marque affiché.
 * @prop {string} [brandSuffix] - Suffixe grisé (ex. "Factory").
 * @prop {string} [href='/'] - Lien de la marque.
 * @prop {string} [glyph] - Emoji/glyphe du marqueur de marque.
 * @prop {string} [tagline] - Phrase d'accroche sous la marque.
 * @prop {{ title:string, links:{label:string, href:string}[] }[]} [columns=[]]
 *   - Colonnes de liens.
 * @prop {string} [legal] - Ligne légale à gauche de la barre du bas.
 * @prop {string} [version] - Mention versionnée à droite (police mono).
 */
interface FooterColumn {
  title: string;
  links: { label: string; href: string }[];
}
interface Props {
  brand: string;
  brandSuffix?: string;
  href?: string;
  glyph?: string;
  tagline?: string;
  columns?: FooterColumn[];
  legal?: string;
  version?: string;
}

const {
  brand,
  brandSuffix,
  href = "/",
  glyph,
  tagline,
  columns = [],
  legal,
  version,
} = Astro.props;

/** Liens externes : nouvel onglet + rel anti-tabnabbing (parité site d'origine). */
const isExternal = (url: string): boolean => /^https?:\/\//i.test(url);
---

<footer class="bdf-footer">
  <div class="bdf-wrap bdf-footer__grid">
    <div>
      <a class="bdf-brand" href={href}>
        <span class:list={["bdf-brand__mark", { "bdf-brand__mark--fleet": !glyph }]} aria-hidden="true">{glyph}</span>
        <span>{brand}{brandSuffix && <span class="bdf-brand__suffix">{brandSuffix}</span>}</span>
      </a>
      {tagline && <p class="bdf-footer__tagline">{tagline}</p>}
    </div>

    {columns.map((col) => (
      <div>
        <h4>{col.title}</h4>
        <ul>
          {col.links.map((l) => (
            <li>
              <a
                href={l.href}
                target={isExternal(l.href) ? "_blank" : undefined}
                rel={isExternal(l.href) ? "noopener noreferrer" : undefined}
              >{l.label}</a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  {(legal || version) && (
    <div class="bdf-wrap bdf-footer__base">
      {legal && <span>{legal}</span>}
      {version && <span class="bdf-footer__version">{version}</span>}
    </div>
  )}
</footer>

<style>
  .bdf-footer {
    padding-block: var(--sp-8) var(--sp-7);
    border-top: 1px solid var(--c-line);
    margin-top: var(--sp-8);
  }
  .bdf-footer__grid {
    display: grid;
    gap: var(--sp-6);
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .bdf-footer__grid { grid-template-columns: 1.4fr repeat(var(--bdf-footer-cols, 2), 1fr); }
  }
  .bdf-footer__tagline {
    color: var(--c-ink-400);
    font-size: var(--fs-sm);
    max-width: 34ch;
    margin-top: var(--sp-3);
    line-height: var(--lh-relaxed);
  }
  .bdf-footer h4 {
    font-family: var(--font-body);
    font-size: var(--fs-2xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--c-ink-400);
    margin-bottom: var(--sp-3);
    font-weight: var(--fw-semibold);
  }
  .bdf-footer ul { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--sp-2); }
  .bdf-footer a {
    font-size: var(--fs-sm);
    color: var(--c-ink-500);
    text-decoration: none;
    transition: color var(--dur-fast);
  }
  .bdf-footer a:hover { color: var(--accent-600); }
  .bdf-footer__base {
    margin-top: var(--sp-7);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--c-line);
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    justify-content: space-between;
    font-size: var(--fs-xs);
    color: var(--c-ink-400);
  }
  .bdf-footer__version { font-family: var(--font-mono); }
</style>
