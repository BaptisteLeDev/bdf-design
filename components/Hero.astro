---
/**
 * Hero — composition typographique neo-grotesque (titre display, beaucoup de blanc).
 *
 * Structure : overline · titre · chapeau · actions. Direction minimale : pas
 * d'amas de blobs. Sans slot `visual`, le Hero est une colonne typographique
 * centrée/alignée à gauche, dominée par un grand titre à tracking serré. Le slot
 * `visual` reste supporté (le portail peut l'utiliser), rendu en colonne discrète.
 * Le titre et le chapeau passent par des slots pour autoriser la mise en valeur
 * (ex. `<em>` accentué).
 *
 * @prop {string} [overline] - Sur-titre mono en majuscules (accent du bot actif).
 * @prop {('default'|'gradient')} [titleStyle='default'] - 'gradient' applique le
 *   dégradé multi-bots de la flotte au contenu marqué `<em>` dans le slot title.
 * @prop {('start'|'center')} [align='start'] - Alignement du bloc texte.
 * @slot title - Titre principal (h1). Requis.
 * @slot lead - Chapeau (paragraphe d'intro).
 * @slot actions - Boutons / liens d'action.
 * @slot visual - Visuel de droite optionnel. aria-hidden conseillé côté appelant.
 */
interface Props {
  overline?: string;
  titleStyle?: "default" | "gradient";
  align?: "start" | "center";
}

const { overline, titleStyle = "default", align = "start" } = Astro.props;
const hasVisual = Astro.slots.has("visual");
---

<section class:list={["bdf-hero", { "bdf-hero--solo": !hasVisual }]}>
  <div class:list={["bdf-wrap", "bdf-hero__grid", { "bdf-hero__grid--solo": !hasVisual }]}>
    <div class:list={["bdf-hero__copy", `bdf-hero__copy--${align}`, { "bdf-hero__title--gradient": titleStyle === "gradient" }]}>
      {overline && <span class="bdf-overline">{overline}</span>}
      <h1 class="bdf-hero__title"><slot name="title" /></h1>
      {Astro.slots.has("lead") && <p class="bdf-hero__lead"><slot name="lead" /></p>}
      {Astro.slots.has("actions") && (
        <div class="bdf-hero__actions"><slot name="actions" /></div>
      )}
    </div>

    {hasVisual && (
      <div class="bdf-hero__art">
        <slot name="visual" />
      </div>
    )}
  </div>
</section>

<style>
  .bdf-hero {
    position: relative;
    padding-top: var(--sp-10);
    padding-bottom: var(--sp-9);
  }
  /* Solo (sans visual) = colonne typographique large, beaucoup de blanc. */
  .bdf-hero--solo { padding-top: clamp(var(--sp-9), 14vh, var(--sp-10)); }
  .bdf-hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-7);
    align-items: center;
  }
  @media (min-width: 940px) {
    .bdf-hero__grid:not(.bdf-hero__grid--solo) {
      grid-template-columns: 1.1fr 0.9fr;
      gap: var(--sp-8);
    }
  }
  .bdf-hero__copy--center { text-align: center; margin-inline: auto; max-width: 22ch; }
  .bdf-hero__copy--center .bdf-hero__lead { margin-inline: auto; }
  .bdf-hero__copy--center .bdf-hero__actions { justify-content: center; }

  /* Stagger d'entrée sobre, CSS pur (opacity + translate léger). */
  .bdf-hero__copy > * {
    animation: bdf-hero-in var(--dur-slow) var(--ease-soft) both;
  }
  .bdf-overline { animation-delay: 0ms; }
  .bdf-hero__title { animation-delay: 60ms; }
  .bdf-hero__lead { animation-delay: 120ms; }
  .bdf-hero__actions { animation-delay: 180ms; }
  @keyframes bdf-hero-in {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .bdf-hero__copy > * { animation: none; }
  }

  .bdf-hero__title {
    font-size: clamp(2.8rem, 8vw, var(--fs-5xl));
    letter-spacing: var(--ls-display);
    line-height: var(--lh-tight);
    font-weight: var(--fw-bold);
    margin-top: var(--sp-5);
    text-wrap: balance;
  }
  /* Le slot title peut contenir <em> mis en valeur via l'accent du bot actif. */
  .bdf-hero__title--gradient :global(em) {
    font-style: normal;
    color: var(--accent-600);
  }
  .bdf-hero__lead {
    font-size: var(--fs-lg);
    line-height: var(--lh-relaxed);
    color: var(--c-ink-500);
    max-width: 46ch;
    margin-top: var(--sp-5);
    text-wrap: pretty;
  }
  .bdf-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3);
    margin-top: var(--sp-7);
  }
  .bdf-hero__art {
    position: relative;
    width: 100%;
    max-width: 420px;
    margin-inline: auto;
  }
</style>
