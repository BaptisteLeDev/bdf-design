---
/**
 * BotCard - carte de présentation d'un bot de la flotte.
 *
 * Pose elle-même `data-bot={bot}` : tout l'intérieur (forme, accent, halo) hérite
 * automatiquement de la teinte du bot - peu importe le contexte parent.
 *
 * @prop {('moodioos'|'renamioos'|'coverioos'|'collabioos')} bot - Identité du bot.
 *   Détermine l'accent et la forme `--bot-blob`.
 * @prop {string} name - Nom affiché (ex. "Moodioos").
 * @prop {string} [tag] - Étiquette catégorie (ex. "bien-être"), en mono accentué.
 * @prop {string} glyph - Emoji/glyphe de la mascotte (dans la forme signature).
 * @prop {string} [href='#'] - Lien de la carte (CTA).
 * @prop {string} [cta='Explorer'] - Libellé du lien d'action.
 * @prop {boolean} [soon=false] - Marque le bot « à venir » (chip + lien désactivé).
 * @slot default - Description du bot.
 */
interface Props {
  bot: "moodioos" | "renamioos" | "coverioos" | "collabioos";
  name: string;
  tag?: string;
  glyph: string;
  href?: string;
  cta?: string;
  soon?: boolean;
}

const {
  bot,
  name,
  tag,
  glyph,
  href = "#",
  cta = "Explorer",
  soon = false,
} = Astro.props;
---

<article class:list={["bdf-bot-card", { "bdf-bot-card--soon": soon }]} data-bot={bot}>
  <span class="bdf-bot-card__shape" aria-hidden="true">{glyph}</span>
  <h3 class="bdf-bot-card__name">
    {name}
    {tag && !soon && <span class="bdf-bot-card__tag">{tag}</span>}
    {soon && <span class="bdf-bot-card__chip">à venir</span>}
  </h3>
  <p class="bdf-bot-card__desc"><slot /></p>
  <a
    class="bdf-bot-card__cta"
    href={soon ? "#" : href}
    aria-disabled={soon ? "true" : undefined}
  >
    {cta} <span class="bdf-bot-card__arrow" aria-hidden="true">→</span>
  </a>
</article>

<style>
  .bdf-bot-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    padding: var(--sp-6);
    background: var(--c-paper-0);
    border: 1px solid var(--c-line);
    border-radius: var(--r-md);
    box-shadow: none;
    overflow: hidden;
    isolation: isolate;
    transition: transform var(--dur-base) var(--ease-soft),
      border-color var(--dur-base);
    will-change: transform;
  }
  .bdf-bot-card:hover {
    transform: translateY(-2px);
    border-color: var(--c-ink-900);
  }

  .bdf-bot-card__shape {
    width: 52px;
    height: 52px;
    border-radius: var(--bot-blob);
    background: var(--accent-500);
    color: #fff;
    display: grid;
    place-items: center;
    font-size: 1.5rem;
  }

  .bdf-bot-card__name {
    font-size: var(--fs-xl);
    color: var(--c-ink-900);
    display: flex;
    align-items: baseline;
    gap: var(--sp-2);
    flex-wrap: wrap;
  }
  .bdf-bot-card__tag {
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--accent-600);
  }
  .bdf-bot-card__chip {
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    letter-spacing: var(--ls-wide);
    text-transform: uppercase;
    color: var(--c-ink-400);
    background: var(--c-paper-100);
    border: 1px solid var(--c-line);
    padding: 2px var(--sp-2);
    border-radius: var(--r-pill);
  }
  .bdf-bot-card__desc {
    font-size: var(--fs-sm);
    color: var(--c-ink-500);
    line-height: var(--lh-relaxed);
    flex: 1;
  }
  .bdf-bot-card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-weight: var(--fw-semibold);
    font-size: var(--fs-sm);
    color: var(--accent-600);
    text-decoration: none;
    transition: gap var(--dur-base) var(--ease-spring);
  }
  .bdf-bot-card__cta[aria-disabled="true"] { cursor: default; }
  .bdf-bot-card:hover .bdf-bot-card__cta { gap: var(--sp-3); }
  .bdf-bot-card__arrow { transition: transform var(--dur-base) var(--ease-spring); }
  .bdf-bot-card:hover .bdf-bot-card__arrow { transform: translateX(3px); }
  .bdf-bot-card--soon { opacity: 0.96; }
</style>
