---
/**
 * CtaBand - bandeau d'appel à l'action, surface accent claire et nette.
 *
 * Direction minimale : aplat accent clair, plus de blobs flottants. Le texte est
 * posé en `--accent-ink` (foncé, AA garanti sur la surface claire de l'accent du
 * bot actif). `decor` rend désormais un fin liseré géométrique statique (ou rien).
 *
 * @prop {string} [overline] - Sur-titre mono (rendu en --accent-ink).
 * @prop {string} title - Titre du bandeau (h2). Requis.
 * @prop {boolean} [decor=true] - Affiche les marqueurs géométriques discrets.
 * @slot lead - Paragraphe sous le titre.
 * @slot actions - Boutons d'action (utiliser .bdf-btn pour le style accent-ink).
 */
interface Props {
  overline?: string;
  title: string;
  decor?: boolean;
}

const { overline, title, decor = true } = Astro.props;
---

<div class="bdf-cta">
  {decor && (
    <>
      <span class="bdf-cta__decor bdf-cta__decor--1" aria-hidden="true"></span>
      <span class="bdf-cta__decor bdf-cta__decor--2" aria-hidden="true"></span>
    </>
  )}
  <div class="bdf-cta__inner">
    {overline && <span class="bdf-overline bdf-cta__overline">{overline}</span>}
    <h2 class="bdf-cta__title">{title}</h2>
    {Astro.slots.has("lead") && <p class="bdf-cta__lead"><slot name="lead" /></p>}
    {Astro.slots.has("actions") && (
      <div class="bdf-cta__actions"><slot name="actions" /></div>
    )}
  </div>
</div>

<style>
  .bdf-cta {
    position: relative;
    overflow: hidden;
    border-radius: var(--r-lg);
    /* Aplat clair de l'accent : le texte foncé --accent-ink garde un contraste
       AA (≥4.5:1) sur tout le bandeau. */
    background: color-mix(in srgb, var(--accent-100) 80%, var(--c-paper-0));
    border: 1px solid var(--accent-200);
    box-shadow: none;
    padding: clamp(2rem, 6vw, var(--sp-9));
    text-align: center;
  }
  .bdf-cta__inner { position: relative; z-index: 1; max-width: 52ch; margin-inline: auto; }
  .bdf-cta__overline { color: var(--accent-ink); }
  .bdf-cta__title {
    color: var(--accent-ink);
    font-size: clamp(1.8rem, 4.5vw, var(--fs-3xl));
    margin-top: var(--sp-3);
  }
  .bdf-cta__lead {
    /* Texte plein (pas de transparence) pour rester AA sur le dégradé. */
    color: var(--accent-ink);
    font-size: var(--fs-lg);
    margin-top: var(--sp-4);
    line-height: var(--lh-relaxed);
  }
  .bdf-cta__actions {
    margin-top: var(--sp-6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    justify-content: center;
  }
  /* Bouton sur fond accent : aplat --accent-ink (contraste fort). */
  .bdf-cta__actions :global(.bdf-btn) { background: var(--accent-ink); }

  /* Marqueurs géométriques discrets, statiques (plus de blobs flottants). */
  .bdf-cta__decor {
    position: absolute;
    border-radius: var(--r-sm);
    border: 1px solid var(--accent-200);
    background: transparent;
  }
  .bdf-cta__decor--1 { width: 96px; height: 96px; top: -32px; right: 6%; transform: rotate(12deg); }
  .bdf-cta__decor--2 { width: 64px; height: 64px; bottom: -22px; left: 9%; transform: rotate(-8deg); }
</style>
