---
/**
 * Nav — barre de navigation sticky, ombre/bordure au scroll.
 *
 * Le marqueur de marque (`brand__mark`) adopte la forme `--bot-blob` et l'accent
 * du bot actif. Sans `glyph`, il affiche un dégradé multi-bots (identité flotte).
 * L'effet « ombre au scroll » est piloté par un petit script vanilla inline
 * (data-scrolled), respectueux de prefers-reduced-motion (pas d'animation).
 *
 * @prop {string} brand - Nom affiché à gauche (ex. "Moodioos").
 * @prop {string} [brandSuffix] - Suffixe grisé accolé (ex. "Factory" → "BotDiscordFactory").
 * @prop {string} [href='/'] - Lien de la marque.
 * @prop {string} [glyph] - Emoji/glyphe dans le marqueur de marque. Si absent,
 *   le marqueur affiche le dégradé multi-bots de la flotte.
 * @prop {{label:string, href:string, current?:boolean}[]} [links=[]] - Liens de nav.
 * @prop {{label:string, href:string}} [cta] - Bouton d'action à droite.
 * @prop {('solid'|'ghost')} [ctaVariant='solid'] - Style du bouton CTA.
 * @prop {boolean} [ctaExternal] - Force target="_blank" rel="noopener noreferrer"
 *   sur le CTA. Si absent, auto-détecté pour les URLs externes (http(s)://...).
 * @prop {string} [ariaLabel='Navigation principale']
 * @slot actions - Contrôles additionnels alignés à droite, AVANT le CTA (ex.
 *   sélecteur de langue). Vivent dans le flux de la nav, donc jamais en conflit
 *   de superposition avec le CTA.
 */
interface NavLink {
  label: string;
  href: string;
  current?: boolean;
}
interface Props {
  brand: string;
  brandSuffix?: string;
  href?: string;
  glyph?: string;
  links?: NavLink[];
  cta?: { label: string; href: string };
  ctaVariant?: "solid" | "ghost";
  ctaExternal?: boolean;
  ariaLabel?: string;
}

const {
  brand,
  brandSuffix,
  href = "/",
  glyph,
  links = [],
  cta,
  ctaVariant = "solid",
  ctaExternal,
  ariaLabel = "Navigation principale",
} = Astro.props;

/** Liens externes : ouverts dans un nouvel onglet, sans fuite via tabnabbing. */
const isExternal = (url?: string): boolean => !!url && /^https?:\/\//i.test(url);
const ctaIsExternal = ctaExternal ?? isExternal(cta?.href);
---

<header class="bdf-nav" data-bdf-nav>
  <div class="bdf-wrap bdf-nav__row">
    <a class="bdf-brand" href={href} aria-label={`${brand}, accueil`}>
      <span class:list={["bdf-brand__mark", { "bdf-brand__mark--fleet": !glyph }]} aria-hidden="true">{glyph}</span>
      <span>{brand}{brandSuffix && <span class="bdf-brand__suffix">{brandSuffix}</span>}</span>
    </a>

    {links.length > 0 && (
      <nav class="bdf-nav__links" aria-label={ariaLabel}>
        {links.map((l) => (
          <a href={l.href} aria-current={l.current ? "page" : undefined}>{l.label}</a>
        ))}
      </nav>
    )}

    <div class="bdf-nav__actions">
      <slot name="actions" />
      {cta && (
        <a
          class:list={["bdf-btn", { "bdf-btn--ghost": ctaVariant === "ghost" }]}
          href={cta.href}
          target={ctaIsExternal ? "_blank" : undefined}
          rel={ctaIsExternal ? "noopener noreferrer" : undefined}
        >
          {cta.label}
        </a>
      )}
    </div>
  </div>
</header>

<style>
  .bdf-nav {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    backdrop-filter: saturate(140%) blur(8px);
    background: color-mix(in srgb, var(--c-paper-50) 78%, transparent);
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-base), background var(--dur-base);
  }
  .bdf-nav[data-scrolled="true"] {
    border-bottom-color: var(--c-line);
    background: color-mix(in srgb, var(--c-paper-50) 92%, transparent);
  }
  .bdf-nav__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }
  .bdf-brand {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    color: var(--c-ink-900);
    letter-spacing: var(--ls-tight);
    text-decoration: none;
  }
  .bdf-brand__suffix { color: var(--c-ink-400); }
  .bdf-brand__mark {
    width: 32px;
    height: 32px;
    border-radius: var(--r-sm);
    background: var(--accent-500);
    color: #fff;
    display: grid;
    place-items: center;
    font-size: 1.05rem;
  }
  .bdf-brand__mark--fleet {
    background: linear-gradient(
      90deg,
      var(--bot-moodioos-500),
      var(--bot-renamioos-500) 45%,
      var(--bot-coverioos-500) 75%,
      var(--bot-collabioos-500)
    );
  }
  /* Zone d'actions à droite : slot (ex. sélecteur de langue) + CTA, dans le flux.
     Aligne et espace ses enfants ; aucun overlay fixe, donc aucune collision. */
  .bdf-nav__actions {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
  }
  /* Liens de nav : visibles à TOUS les breakpoints (resserrés sur mobile) plutôt
     que masqués sous 820px. Évite la perte du lien de nav sur mobile sans recourir
     à un overlay hamburger (ceremony pour des ancres internes courtes). */
  .bdf-nav__links {
    display: inline-flex;
    gap: var(--sp-4);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
  }
  .bdf-nav__links a {
    color: var(--c-ink-500);
    text-decoration: none;
    transition: color var(--dur-fast);
  }
  .bdf-nav__links a:hover,
  .bdf-nav__links a[aria-current="page"] { color: var(--c-ink-900); }
  @media (min-width: 820px) {
    .bdf-nav__links { gap: var(--sp-6); }
  }
  /* Très petits écrans : on masque le mark de marque texte au profit du glyphe
     si l'espace manque — mais on garde brand + lien(s) + CTA accessibles. */
  @media (max-width: 360px) {
    .bdf-nav__links { gap: var(--sp-3); font-size: var(--fs-xs); }
  }
</style>

<script>
  // Ombre/bordure au scroll — vanilla, idempotent, sans dépendance.
  (() => {
    const nav = document.querySelector<HTMLElement>("[data-bdf-nav]");
    if (!nav) return;
    const onScroll = () => {
      nav.dataset.scrolled = window.scrollY > 8 ? "true" : "false";
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  })();
</script>
